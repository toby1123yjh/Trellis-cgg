{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter @mindfoldhq/trellis-core build && pnpm --filter trellis-ccg-lite build",
    "build:core": "pnpm --filter @mindfoldhq/trellis-core build",
    "build:cli": "pnpm --filter trellis-ccg-lite build",
    "test": "pnpm --filter @mindfoldhq/trellis-core test && pnpm --filter trellis-ccg-lite test",
    "test:core": "pnpm --filter @mindfoldhq/trellis-core test",
    "test:cli": "pnpm --filter trellis-ccg-lite test",
    "lint": "pnpm --filter @mindfoldhq/trellis-core lint && pnpm --filter trellis-ccg-lite lint",
    "typecheck": "pnpm --filter @mindfoldhq/trellis-core build && pnpm --filter trellis-ccg-lite typecheck",
    "pack:lite": "pnpm --filter trellis-ccg-lite pack"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
